# Virtual Environment
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution & Build
build/
dist/
*.egg-info/
.eggs/

# Media & Audio Files (Prevent large binary files in git)
*.webm
*.mp4
*.mkv
*.mov
*.avi
*.flv
*.wmv
*.m4v
*.ts
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus

# Local Data Directories (Keep folder structure via .gitkeep)
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configuration
.idea/
.vscode/
*.swp
*.swo

# Environment Variables & Tokens
.env
.env.*
!uv.lock

# Testing & Tool Caches
.pytest_cache/
.ruff_cache/
